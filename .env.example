# ─────────────────────────────────────────────────────────────
# ProofyX Environment Variables
# Copy this file to .env and fill in your actual keys.
# Multiple keys per service enable automatic fallback.
# ─────────────────────────────────────────────────────────────

# Database (PostgreSQL recommended for production)
# If not set, falls back to local SQLite (dev mode).
DATABASE_URL=postgresql+asyncpg://proofyx:proofyx_dev@localhost:5432/proofyx

# Supabase Authentication (backend)
# If not set, auth is disabled and all requests pass through (dev mode).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# ProofyX REST API Authentication (API key mode)
# If set, all /api/v1/analyze/* endpoints require X-API-Key header.
# If no keys are set and no Supabase config, the API runs unauthenticated (dev mode).
PROOFYX_API_KEY_1=
PROOFYX_API_KEY_2=

# Google Cloud Vision (future integration)
GOOGLE_VISION_KEY_1=
GOOGLE_VISION_KEY_2=

# Bing Visual Search (Azure AI Vision) — powers the opt-in "Reverse Image
# Search" checkbox on the Document Analysis page. No free tier ships with
# this project; provision your own Azure resource. Leave unset to hide
# the checkbox (it self-disables when this key is absent).
BING_VISUAL_SEARCH_API_KEY=

# HuggingFace Hub Token
HF_TOKEN_1=

# Twilio (future: SMS/voice verification)
TWILIO_SID_1=
TWILIO_TOKEN_1=
TWILIO_SID_2=
TWILIO_TOKEN_2=

# CORS (set these in HF Spaces secrets after deploying to Vercel)
# Comma-separated exact origins:
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173
# Regex pattern for Vercel preview deployments (optional):
CORS_ORIGINS_REGEX=https://.*\.vercel\.app

# ─────────────────────────────────────────────────────────────
# Frontend Environment Variables (prefix with VITE_ for Vite)
# ─────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Point the frontend at the HF Spaces backend (set this in Vercel env vars):
VITE_API_URL=https://abr-6024-proofyx.hf.space
